{
  "name": "prumo-desktop",
  "productName": "Prumo Desktop",
  "version": "0.0.1",
  "repository": "github:stjosephworks/prumo-desktop",
  "private": true,
  "description": "Desktop app for Prumo: create, follow and run Prumo projects",
  "main": ".vite/build/main.js",
  "author": "Leonardo Freitas",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/fix-spawn-helper.mjs",
    "prepare-run": "node scripts/fix-spawn-helper.mjs && node scripts/embed-cli.mjs",
    "start": "pnpm prepare-run && electron-forge start",
    "package": "pnpm prepare-run && electron-forge package",
    "release": "pnpm prepare-run && FORGE_OUT_DIR=out/arm64 electron-forge publish --arch=arm64 && FORGE_OUT_DIR=out/x64 electron-forge publish --arch=x64",
    "icon": "electron scripts/make-icon.mjs",
    "lint": "biome check",
    "typecheck": "tsc --noEmit",
    "test": "pnpm prepare-run && vitest run",
    "smoke": "pnpm package && node scripts/smoke.mjs"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/publisher-github": "7.11.2",
    "@types/node": "24.13.4",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.1",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-serif": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-router": "1.170.36",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "fix-path": "5.0.0",
    "lucide-react": "1.45.0",
    "node-pty": "1.1.0",
    "qrcode": "1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwindcss": "4.3.3",
    "update-electron-app": "3.3.0"
  }
}
